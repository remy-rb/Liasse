# Copied to .env by `make setup`. The Makefile and Docker Compose both read .env.

# --- Postgres (Docker Compose `db` service) ---
POSTGRES_USER=liasse
POSTGRES_PASSWORD=liasse
POSTGRES_DB=liasse
# Port published on your machine; change it if 5432 is taken.
POSTGRES_PORT=5432

# --- Backend ---
# Required. How the backend reaches Postgres when run on your machine (`make dev`).
# In Docker (`make up`) Compose points it at the `db` service instead.
DATABASE_URL=postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}
# Database used by `make test`; created automatically by the `db` service.
TEST_DATABASE_URL=postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/liasse_test

# Required, at least 32 characters. Signs the login session cookie.
# `make setup` replaces this placeholder with a random value.
SESSION_SECRET=change-me
# Set to true once Liasse is served over HTTPS, so the cookie is never sent in clear.
SESSION_COOKIE_SECURE=false

# --- Frontend ---
# Port the full stack is served on with `make up` (http://localhost:8080).
LIASSE_PORT=8080
