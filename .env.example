# Copied to .env by `make setup`. The Makefile and Docker Compose both read .env.

# --- Postgres (Docker Compose `db` service) ---
POSTGRES_USER=liasse
POSTGRES_PASSWORD=liasse
POSTGRES_DB=liasse
# Port published on your machine; change it if 5432 is taken.
POSTGRES_PORT=5432

# --- Backend ---
# Required. How the backend reaches Postgres when run on your machine (`make dev`).
# In Docker (`make up`) Compose points it at the `db` service instead.
DATABASE_URL=postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}
# Database used by `make test`; created automatically by the `db` service.
TEST_DATABASE_URL=postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/liasse_test

# Required, at least 32 characters. Signs the login session cookie.
# `make setup` replaces this placeholder with a random value.
SESSION_SECRET=change-me
# Set to true once Liasse is served over HTTPS, so the cookie is never sent in clear.
SESSION_COOKIE_SECURE=false

# Where the Archive lives (your Documents as PDFs, browsable without Liasse).
# A local folder path, or a file:// URL. Default with `make dev`: the data/ folder of this repo.
# In Docker (`make up`) it is the archive-data volume, unless you set ARCHIVE_DIR below.
# STORAGE_URL=/path/to/your/Archive
# Optional: a folder on your machine to hold the Archive when running in Docker.
# ARCHIVE_DIR=/path/to/your/Archive
# Largest file accepted for upload, in bytes (default 50 MB).
# UPLOAD_MAX_BYTES=52428800

# --- AI model (needed by the worker to file Documents) ---
# Any LiteLLM model name. Documents' page text is sent to this provider, except with Ollama.
# Claude:  LLM_MODEL=anthropic/claude-opus-5-5   and LLM_API_KEY=<your Anthropic API key>
#          (anthropic/claude-haiku-5-5 is much cheaper; check its accuracy with your Documents)
# OpenAI:  LLM_MODEL=openai/<model>              and LLM_API_KEY=<your OpenAI API key>
# Ollama:  LLM_MODEL=ollama/<model>              and LLM_API_BASE=http://localhost:11434
#          (from Docker, use LLM_API_BASE=http://host.docker.internal:11434)
LLM_MODEL=
LLM_API_KEY=
LLM_API_BASE=
# Below this confidence (0 to 1) for Category, Correspondent or Document Date, a Document
# goes to the Inbox for you to check instead of being Filed.
INBOX_THRESHOLD=0.7

# --- Frontend ---
# Port the full stack is served on with `make up` (http://localhost:8080).
LIASSE_PORT=8080
